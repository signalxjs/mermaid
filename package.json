{
    "name": "sigx-mermaid-monorepo",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.33.4",
    "description": "Monorepo for @sigx/mermaid — mermaid diagrams for sigx, lazily rendered on the client",
    "type": "module",
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "sync:core": "node scripts/sync-core.mjs",
        "verify:catalog": "node scripts/check-catalog.mjs",
        "wt": "node scripts/worktree.mjs",
        "branch-protection": "node scripts/apply-branch-protection.mjs",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build": "pnpm --filter @sigx/mermaid run build",
        "typecheck": "tsgo --noEmit",
        "lint": "oxlint packages/mermaid/src",
        "lint:fix": "oxlint --fix packages/mermaid/src",
        "publish:dry": "node scripts/publish.js --dry-run",
        "publish:all": "node scripts/publish.js",
        "publish:beta": "node scripts/publish.js --tag beta",
        "verify:pack": "node scripts/verify-pack.js",
        "version:set": "node scripts/bump-version.js",
        "version:patch": "node scripts/bump-version.js patch",
        "version:minor": "node scripts/bump-version.js minor",
        "version:major": "node scripts/bump-version.js major",
        "size": "size-limit",
        "clean": "node -e \"const fs=require('fs'),p=require('path');const rm=x=>fs.rmSync(x,{recursive:true,force:true});for(const d of fs.readdirSync('packages')){rm(p.join('packages',d,'dist'));rm(p.join('packages',d,'node_modules'));}rm('node_modules');rm('pnpm-lock.yaml');\""
    },
    "devDependencies": {
        "@size-limit/preset-small-lib": "^11",
        "@typescript/native-preview": "7.0.0-dev.20260704.1",
        "@vitest/coverage-v8": "^4.1.5",
        "happy-dom": "^20.10.6",
        "oxlint": "^1.63.0",
        "size-limit": "^11",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    },
    "keywords": [
        "sigx",
        "signalx",
        "mermaid",
        "diagram",
        "flowchart",
        "documentation"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/mermaid.git"
    },
    "homepage": "https://sigx.dev/",
    "bugs": {
        "url": "https://github.com/signalxjs/mermaid/issues"
    }
}
